# Python
__pycache__/
*.pyc
.venv/
venv/
backend/.env

# Streamlit secrets (API keys) — never commit
.streamlit/secrets.toml

# Models & raw data (too large / reproducible via scripts, not for git) —
# except the two small, already-trained checkpoints the Streamlit app needs
# to run out of the box (risk_model.joblib ~100KB, wildfire-smoke.pt ~5MB).
# See README "Model Performance" for provenance of each.
*.pt
*.onnx
*.h5
*.pkl
*.joblib
!backend/models/risk_model.joblib
!backend/models/wildfire-smoke.pt
backend/data/raw/
backend/runs/
backend/ml/detect/.fasdd_cv.resolved.yaml

# data/processed/ (metrics JSON, confusion matrix plots, cleaned CSV) is
# intentionally tracked — it's the evidence that training actually ran.

# Env files
.env
.env.local

# OS
.DS_Store

# Local tooling state (not part of the project)
.claude/
