# Supabase (user registration, location, push subscriptions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Backend inference (FastAPI on HF Spaces / Render)
BACKEND_INFERENCE_URL=https://your-backend.hf.space

# Data sources
NASA_FIRMS_MAP_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Protects the cron endpoint from public access
CRON_SECRET=replace-with-a-random-string
